---
// Main site header: logo, pill nav, "Coba gratis" and the mobile menu. Dark on the landing hero,
// light on the blog (design/Belli Blog.dc.html). `current` marks the active nav link.
// Sticky: the bar is fixed at the spot the caller's `pt-3` > `max-w-[1200px]` box gives it, and the
// 88px placeholder keeps its place in the flow. Once the page scrolls, the script sets data-stuck:
// the bar gets a background and shrinks to 68px (global.css scroll-padding-top follows that height).
import Button from './ui/Button.astro';

type Props = { tone?: 'dark' | 'light'; current?: string };

const { tone = 'dark', current } = Astro.props;
const nav = [
  ['/#fitur', 'Fitur'],
  ['/#contoh', 'Contoh'],
  ['/#demo', 'Demo'],
  ['/#harga', 'Harga'],
  ['/#faq', 'Tanya jawab'],
  ['/blog', 'Blog'],
  ['/kontak', 'Kontak'],
];
const dark = tone === 'dark';
---

<div class="h-[88px]">
  <div
    data-header-bar
    class:list={[
      'group/bar fixed inset-x-3 top-3 z-40 max-w-[1200px] mx-auto rounded-[20px] transition-[background-color,box-shadow] duration-300 data-stuck:backdrop-blur-md',
      dark
        ? 'data-stuck:bg-navy/90 data-stuck:shadow-[0_0_0_1px_rgba(255,255,255,.08),0_14px_34px_-14px_rgba(10,19,48,.6)]'
        : 'data-stuck:bg-white/90 data-stuck:shadow-[0_0_0_1px_var(--color-border),0_14px_34px_-18px_rgba(16,24,40,.3)]',
    ]}
  >
  <header class:list={['flex items-center justify-between gap-4 px-6 py-[22px] transition-[padding] duration-300 group-data-stuck/bar:py-3', dark ? 'text-white' : 'text-foreground']}>
    <a href="/" class="flex items-center gap-2.5 no-underline text-inherit">
      <span class="size-[34px] rounded-[10px] bg-primary text-white grid place-items-center text-lg font-bold leading-none shadow-[0_0_0_4px_rgba(47,107,255,.25)]">B</span>
      <span class="text-xl font-semibold leading-none tracking-[-.01em]">Belli</span>
    </a>
    <nav class:list={['flex gap-1.5 rounded-full p-[5px] border max-[1040px]:hidden', dark ? 'bg-white/[.07] border-white/10' : 'bg-canvas border-border']}>
      {
        nav.map(([href, label]) => (
          <a
            href={href}
            aria-current={href === current ? 'page' : undefined}
            class:list={[
              'no-underline text-sm font-medium leading-none px-4 py-[9px] rounded-full whitespace-nowrap',
              dark
                ? 'text-white hover:bg-white/10 aria-[current=page]:bg-white/15'
                : 'text-body-strong hover:bg-white hover:text-foreground aria-[current=page]:bg-white aria-[current=page]:text-foreground aria-[current=page]:shadow-[0_1px_2px_rgba(16,24,40,.08)]',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <Button href="/kontak?topik=program-perintis" size="sm">Coba gratis</Button>
      <button
        data-menu-toggle
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="menu"
        class:list={[
          'hidden max-[1040px]:grid place-items-center w-11 h-[42px] p-0 rounded-[10px] border cursor-pointer',
          dark ? 'border-white/20 bg-white/[.08] text-white' : 'border-border bg-white text-foreground',
        ]}
      >
        <svg data-menu-icon="open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg data-menu-icon="close" hidden width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </header>
  <div id="menu" hidden class="absolute top-full mt-1 inset-x-4 z-30 flex flex-col p-2 bg-white rounded-2xl border border-border shadow-[0_30px_60px_-20px_rgba(10,19,48,.6)]">
    {
      nav.map(([href, label]) => (
        <a href={href} data-menu-close aria-current={href === current ? 'page' : undefined} class="text-foreground no-underline text-base font-medium leading-none px-4 py-3.5 rounded-[10px] hover:bg-canvas aria-[current=page]:bg-canvas">
          {label}
        </a>
      ))
    }
  </div>
  </div>
</div>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.getElementById('menu')!;
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.querySelector('[data-menu-icon="open"]')!.toggleAttribute('hidden', open);
    burger.querySelector('[data-menu-icon="close"]')!.toggleAttribute('hidden', !open);
  };
  burger.addEventListener('click', () => setMenu(menu.hidden));
  menu.querySelectorAll('[data-menu-close]').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  const bar = document.querySelector<HTMLElement>('[data-header-bar]')!;
  const stick = () => bar.toggleAttribute('data-stuck', scrollY > 8);
  addEventListener('scroll', stick, { passive: true });
  stick();
</script>
