---
// Article card for the /blog grid and "Artikel lainnya". Extra data-* attributes and `hidden` pass through.
import Cover from './Cover.astro';
import { type Post, categoryStyle, formatDate, readTime } from '../../lib/blog';

type Props = { post: Post; hidden?: boolean; [key: `data-${string}`]: unknown };

const { post, ...rest } = Astro.props;
const { title, excerpt, category, date } = post.data;
---

<a href={`/blog/${post.id}`} data-card class="flex flex-col gap-4 no-underline text-inherit hover:text-inherit transition-transform duration-250 hover:-translate-y-1" {...rest}>
  <Cover post={post} class="aspect-[4/3] rounded-[20px]" widths={[400, 800]} sizes="(min-width: 1080px) 380px, (min-width: 720px) 50vw, 100vw" />
  <div class="flex items-center gap-2.5">
    <span class:list={['text-[12.5px] font-semibold leading-none rounded-full px-2.5 py-1.5', categoryStyle[category]]}>{category}</span>
    <span class="text-[13.5px] leading-none text-muted-foreground">{readTime(post)} baca</span>
  </div>
  <h3 class="m-0 text-[21px] leading-[1.3] font-semibold tracking-[-.01em] text-pretty">{title}</h3>
  <p class="m-0 text-[15.5px] leading-[1.55] text-body text-pretty">{excerpt}</p>
  <span class="text-sm leading-none text-muted-foreground">{formatDate(date)}</span>
</a>
