---
// shadcn-style badge. "sticker" is the design's tilted yellow (or rose) label; rotate is in degrees.
type Props = {
  variant: keyof typeof variants;
  rotate?: number;
  color?: 'sun' | 'rose';
  class?: string;
};

const variants = {
  sticker: 'inline-block text-navy text-[13px] font-semibold leading-none px-[11px] py-[7px] rounded-md shadow-[0_2px_0_rgba(0,0,0,.25)]',
  cek: 'text-[10px] font-semibold leading-none tracking-[.06em] text-warn bg-warn-bg px-2 py-[5px] rounded-full whitespace-nowrap',
  soon: 'text-[10px] font-semibold leading-none tracking-[.06em] text-body bg-border-soft px-2 py-[5px] rounded-full',
  success: 'inline-flex items-center gap-[5px] text-[10px] font-medium leading-none text-success bg-success-bg px-2 py-[5px] rounded-full',
};

const { variant, rotate, color = 'sun', class: className } = Astro.props;
---

<span
  class:list={[variants[variant], variant === 'sticker' && (color === 'rose' ? 'bg-rose' : 'bg-sun'), className]}
  style={rotate ? `transform:rotate(${rotate}deg)` : undefined}><slot /></span
>
