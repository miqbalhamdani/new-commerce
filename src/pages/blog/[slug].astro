---
// Port of "design/Belli Blog Detail.dc.html". The table of contents is the article's ## headings.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Blog from '../../layouts/Blog.astro';
import Cover from '../../components/blog/Cover.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { AUTHORS, type Post, formatDate, getPosts, initials, readTime } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { title, excerpt, category, date, author, cover, products, productsCaption } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const person = AUTHORS[author];
// Up to three other articles, same category first, newest first.
const others = posts.filter((p) => p !== post);
const related = [...others.filter((p) => p.data.category === category), ...others.filter((p) => p.data.category !== category)].slice(0, 3);
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const shareBtn = 'inline-flex items-center gap-[7px] text-sm font-semibold leading-none text-foreground no-underline bg-white border border-border rounded-[10px] px-3 py-2.5 min-h-10 cursor-pointer hover:border-primary hover:text-foreground';
---

<Blog title={`${title} · Blog Belli`} description={excerpt}>
  <div data-progress class="fixed left-0 top-0 z-50 h-[3px] w-full origin-left scale-x-0 bg-primary" aria-hidden="true"></div>

  <div class="max-w-[880px] mx-auto px-6 pt-10 pb-12 flex flex-col items-center text-center gap-[22px]">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2.5 text-sm font-medium leading-none text-faint">
      <a href="/blog" class="text-body no-underline hover:text-primary">Blog</a><span aria-hidden="true">/</span><span class="text-foreground">{category}</span>
    </nav>
    <h1 class="m-0 text-[clamp(34px,4.8vw,56px)] leading-[1.08] font-semibold tracking-[-.03em] text-balance">{title}</h1>
    <p class="m-0 max-w-[680px] text-[19px] leading-[1.6] text-body text-pretty">{excerpt}</p>
    <div class="flex flex-wrap items-center justify-center gap-x-3.5 gap-y-2.5 text-[14.5px] leading-none text-muted-foreground">
      <span class="flex-none size-9 rounded-full bg-primary text-white grid place-items-center text-[13px] font-bold leading-none">{initials(author)}</span>
      <span class="font-semibold text-foreground">{author}</span>
      <span aria-hidden="true" class="size-1 rounded-full bg-border-strong"></span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true" class="size-1 rounded-full bg-border-strong"></span>
      <span>{readTime(post)} baca</span>
    </div>
  </div>
  {
    cover && (
      <div class="max-w-[1200px] mx-auto px-6">
        <Cover post={post} eager class="h-[clamp(260px,42vw,500px)] rounded-[28px] shadow-[0_30px_60px_-44px_rgba(10,19,48,.35)]" widths={[800, 1600, 2300]} sizes="(min-width: 1200px) 1152px, 100vw" />
      </div>
    )
  }

  <main class="max-w-[1248px] mx-auto px-6 pt-16 pb-14 flex flex-wrap justify-center gap-16 items-start">
    <aside class="flex-[0_0_240px] sticky top-8 flex flex-col gap-7 max-[900px]:hidden">
      {
        toc.length > 0 && (
          <div class="flex flex-col gap-3">
            <span class="text-[13px] font-semibold leading-none tracking-[.08em] uppercase text-muted-foreground">Di artikel ini</span>
            <nav class="flex flex-col" aria-label="Di artikel ini">
              {toc.map((h) => (
                <a
                  href={`#${h.slug}`}
                  data-toc={h.slug}
                  class="border-l-2 border-border pl-4 py-[9px] text-[15px] leading-[1.4] text-muted-foreground no-underline transition-colors duration-200 hover:text-foreground aria-[current=true]:border-primary aria-[current=true]:text-foreground aria-[current=true]:font-semibold"
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        )
      }
      <div class="flex flex-col gap-3 border-t border-border pt-[22px]">
        <span class="text-[13px] font-semibold leading-none tracking-[.08em] uppercase text-muted-foreground">Bagikan</span>
        <div class="flex flex-wrap gap-2">
          <a href={'https://wa.me/?text=' + encodeURIComponent(title + ' ' + url)} target="_blank" rel="noopener" class={shareBtn}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg>WhatsApp
          </a>
          <button type="button" data-copy={url} class:list={[shareBtn, 'data-[copied]:text-success']}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg><span data-copy-label>Salin link</span>
          </button>
        </div>
      </div>
    </aside>

    <article data-article class="flex-[1_1_560px] min-w-0 max-w-[720px] flex flex-col gap-5">
      <div class="blog-body"><Content /></div>

      {
        products.length > 0 && (
          <figure class="my-2 mx-0 flex flex-col gap-2.5">
            {products.map((p) => (
              <div class="border border-border rounded-[22px] p-3.5 flex flex-wrap items-center gap-[18px]">
                {p.image && <Image src={p.image} alt="" width={224} height={224} class="flex-none size-28 rounded-[14px] object-cover" />}
                <div class="flex-[1_1_180px] flex flex-col gap-1.5">
                  <span class="text-lg font-semibold leading-[1.25]">{p.name}</span>
                  {p.meta && <span class="text-[14.5px] leading-none text-muted-foreground">{p.meta}</span>}
                  {p.price && <span class="text-lg font-semibold leading-none text-primary-hover">{p.price}</span>}
                </div>
                <span aria-hidden="true" class="inline-flex items-center gap-2 bg-navy text-white text-[14.5px] font-semibold leading-none px-4 py-[13px] rounded-xl">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg>Pesan via WhatsApp
                </span>
              </div>
            ))}
            {productsCaption && <figcaption class="text-[13.5px] leading-[1.4] text-muted-foreground">{productsCaption}</figcaption>}
          </figure>
        )
      }

      <div class="mt-9 border-t border-border pt-8 flex gap-[18px] items-start">
        <span class="flex-none size-14 rounded-full bg-primary text-white grid place-items-center text-[19px] font-bold leading-none">{initials(author)}</span>
        <div class="flex flex-col gap-2">
          <span class="text-base leading-[1.3] text-body"><strong class="font-semibold text-foreground">{author}</strong>{person && ` · ${person.role}`}</span>
          {person && <p class="m-0 text-[15.5px] leading-[1.6] text-body text-pretty">{person.bio}</p>}
          {
            person?.linkedin && (
              <a href={person.linkedin} target="_blank" rel="noopener" class="self-start inline-flex items-center gap-2 text-[15px] font-semibold leading-none text-primary no-underline py-1">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.1c0-1.22-.02-2.79-1.7-2.79-1.7 0-1.96 1.33-1.96 2.7V21h-4z" /></svg>
                Lihat profil LinkedIn
              </a>
            )
          }
        </div>
      </div>
    </article>
  </main>

  {
    related.length > 0 && (
      <section class="max-w-[1248px] mx-auto px-6 pt-10 pb-24 flex flex-col gap-9">
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-10">
          <h2 class="m-0 text-[30px] leading-[1.2] font-semibold tracking-[-.02em]">Artikel lainnya</h2>
          <a href="/blog" class="inline-flex items-center gap-2 text-[15.5px] font-semibold leading-none text-primary no-underline py-2">
            Lihat semua artikel<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,320px),1fr))] gap-x-7 gap-y-12">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )
  }
</Blog>

<script>
  // Reading progress bar and the active table-of-contents link, both from the scroll position.
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const article = document.querySelector<HTMLElement>('[data-article]')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const heads = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
  let raf = 0;
  const update = () => {
    raf = 0;
    const r = article.getBoundingClientRect();
    const p = Math.max(0, Math.min(1, (innerHeight * 0.4 - r.top) / Math.max(1, r.height)));
    bar.style.transform = `scaleX(${p})`;
    let active = heads[0]?.id;
    for (const h of heads) if (h.getBoundingClientRect().top < 160) active = h.id;
    for (const a of links) a.setAttribute('aria-current', String(a.dataset.toc === active));
  };
  addEventListener('scroll', () => (raf ||= requestAnimationFrame(update)), { passive: true });
  update();

  // Copy link: the label confirms for 1.8 s.
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  copy?.addEventListener('click', () => {
    navigator.clipboard?.writeText(copy.dataset.copy!).catch(() => {});
    const label = copy.querySelector('[data-copy-label]')!;
    copy.toggleAttribute('data-copied', true);
    label.textContent = 'Link tersalin';
    setTimeout(() => {
      copy.removeAttribute('data-copied');
      label.textContent = 'Salin link';
    }, 1800);
  });
</script>
