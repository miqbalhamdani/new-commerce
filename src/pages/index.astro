---
// Port of "Belli Landing Page v8.dc.html" (design/). One section per design comment block.
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import Marquee from '../sections/Marquee.astro';
import Problem from '../sections/Problem.astro';
import Features from '../sections/Features.astro';
import Examples from '../sections/Examples.astro';
import About from '../sections/About.astro';
import Dashboard from '../sections/Dashboard.astro';
import CaraMulai from '../sections/CaraMulai.astro';
import Pricing from '../sections/Pricing.astro';
import Compare from '../sections/Compare.astro';
import Fit from '../sections/Fit.astro';
import Faq from '../sections/Faq.astro';
import DevBand from '../sections/DevBand.astro';
import FinalCta from '../sections/FinalCta.astro';
import Footer from '../sections/Footer.astro';
import { config, waNumber } from '../config';

const site = 'https://belli.id/';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': site + '#organization',
    name: 'Belli',
    url: site,
    logo: site + 'favicon.png',
    email: config.email,
    telephone: '+' + waNumber,
    address: { '@type': 'PostalAddress', addressLocality: 'Bekasi', addressRegion: 'Jawa Barat', addressCountry: 'ID' },
    founder: { '@type': 'Person', name: 'Iqbal Hamdani', sameAs: 'https://www.linkedin.com/in/iqbalhamdani/' },
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Belli', url: site, inLanguage: 'id-ID', publisher: { '@id': site + '#organization' } },
];
---

<Base schema={schema}>
  <div class="bg-white overflow-x-clip">
    <main>
    <Hero />
    <Marquee />
    <Problem />
    <Features />
    <Examples />
    <About />
    <Dashboard />
    {config.showCaraMulai && <CaraMulai />}
    <Pricing />
    <Compare />
    <Fit />
    <div class="bg-band">
      <Faq />
      <DevBand />
    </div>
    <FinalCta />
    </main>
    <Footer />
  </div>
</Base>
