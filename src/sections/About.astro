---
// v8: big founder quote on the left, three numbered promises and a WhatsApp link on the right.
import { waHref } from '../config';

const points = [
  { title: 'Dijawab langsung lewat WhatsApp', text: 'Hari kerja, biasanya di hari yang sama. Saya sendiri yang membalas.' },
  { title: 'Permintaanmu didengar', text: 'Fitur yang diminta banyak toko, masuk ke Belli.' },
  { title: 'Tokomu tetap milikmu', text: 'Domain atas namamu, dan data pesanan bisa kamu unduh kapan saja.' },
];
---

<section class="bg-band px-6 py-24 scroll-mt-3">
  <div class="max-w-[1200px] mx-auto flex flex-col gap-14">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-b border-border-strong pb-6">
      <h2 class="h-section">Siapa di balik Belli</h2>
      <p class="m-0 text-lg leading-normal text-body">Dibuat dan dijawab oleh orang yang sama.</p>
    </div>
    <div class="grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-x-16 gap-y-12 items-start">
      <div class="flex flex-col gap-10">
        <span aria-hidden="true" class="h-14 text-[120px] font-bold leading-[.6] text-primary">“</span>
        <p class="m-0 text-[clamp(24px,2.6vw,34px)] leading-[1.32] font-medium tracking-[-.02em] text-pretty">
          Kalau saya cari barang di Google, yang muncul sering reseller. Kadang tidak ada sama sekali karena brand-nya belum punya website.{' '}
          <span class="text-primary-hover">Belli saya buat supaya pembeli bisa menemukan brand-mu langsung, lengkap dengan variannya.</span>
        </p>
        <div class="flex items-start gap-4 border-t border-border-strong pt-6">
          <span class="flex-none size-14 rounded-full bg-primary text-white grid place-items-center text-[19px] font-bold leading-none">IH</span>
          <div class="flex flex-col gap-2">
            <span class="text-[17px] leading-[1.3] text-body"><strong class="font-semibold text-foreground">Iqbal Hamdani</strong> · Pembuat Belli</span>
            <p class="m-0 text-[15.5px] leading-[1.55] text-body max-w-[520px] text-pretty">10+ tahun membangun website dan sistem, sekarang untuk perusahaan SaaS global. Standar yang sama saya pakai di Belli.</p>
            <a href="https://www.linkedin.com/in/iqbalhamdani/" target="_blank" rel="noopener" class="self-start inline-flex items-center gap-2 text-[15px] font-semibold leading-none text-primary no-underline mt-0.5 py-1">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
                ><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.1c0-1.22-.02-2.79-1.7-2.79-1.7 0-1.96 1.33-1.96 2.7V21h-4z"
                ></path></svg
              >Lihat profil LinkedIn
            </a>
          </div>
        </div>
      </div>
      <div class="flex flex-col">
        {
          points.map((pt, i) => (
            <div class="grid grid-cols-[84px_1fr] gap-4 items-start py-[26px] border-b border-border-strong">
              <span aria-hidden="true" class="text-[56px] font-bold leading-[.9] tracking-[-.04em] text-transparent [-webkit-text-stroke:1.5px_var(--color-primary)]">0{i + 1}</span>
              <div class="flex flex-col gap-1.5">
                <h3 class="m-0 text-[19px] leading-[1.3] font-semibold">{pt.title}</h3>
                <p class="m-0 text-[15.5px] leading-[1.55] text-body text-pretty">{pt.text}</p>
              </div>
            </div>
          ))
        }
        <a
          href={waHref}
          class="group mt-7 flex items-center justify-between gap-4 text-2xl font-semibold leading-[1.2] tracking-[-.015em] text-foreground no-underline pb-3.5 border-b-2 border-primary transition-colors duration-200 hover:text-primary"
        >
          Tanya lewat WhatsApp
          <span class="flex-none size-11 rounded-full bg-primary text-white grid place-items-center transition-transform duration-200 group-hover:translate-x-1">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
