---
// v8: three steps on a connector line. Step 1 has a plan picker; the chosen plan shows in step 3,
// and the own-domain line greys out for Mulai (it only has namatoko.belli.id).
import { config } from '../config';

const plans = [
  ['Mulai', 'Rp49rb'],
  ['Katalog', 'Rp99rb'],
  ['Jualan', 'Rp199rb'],
];
const circle = 'relative z-1 size-14 rounded-full grid place-items-center text-[17px] font-bold leading-none shadow-[0_0_0_2px_var(--color-primary),0_0_0_8px_#fff]';
const h3 = 'm-0 text-xl leading-[1.35] font-semibold text-pretty';
---

<section data-plan="Katalog" class="group/cara bg-band px-6 py-24 scroll-mt-3">
  <div class="max-w-[1200px] mx-auto flex flex-col gap-14">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div class="flex flex-col gap-2.5 max-w-[640px]">
        <h2 class="h-section text-balance">Tiga langkah sampai tokomu tayang.</h2>
      </div>
      <p class="m-0 max-w-[380px] text-[17px] leading-normal text-body text-pretty">Setelah itu, produk, harga, dan artikel kamu update sendiri.</p>
    </div>

    <ol class="relative list-none m-0 p-0 grid lg:grid-cols-3 gap-10">
      <span aria-hidden="true" class="max-lg:hidden absolute left-7 right-[calc(33.33%-28px)] top-[27px] h-0.5 bg-[linear-gradient(90deg,#DCE6FF,#2F6BFF)]"></span>
      <li class="flex flex-col gap-[18px]">
        <span class:list={[circle, 'bg-white text-primary']}>01</span>
        <h3 class={h3}>Daftar dan pilih paket.</h3>
        <div class="flex flex-col gap-3">
          <div role="group" aria-label="Pilih paket" class="self-start flex gap-1 bg-canvas border border-border rounded-full p-1">
            {
              plans.map(([name, price]) => (
                <button
                  type="button"
                  data-plan-set={name}
                  data-price={price}
                  aria-pressed={String(name === 'Katalog')}
                  class="border-0 cursor-pointer rounded-full px-4 py-2.5 min-h-11 text-sm font-semibold leading-none bg-transparent text-body aria-pressed:bg-navy aria-pressed:text-white transition-colors duration-250"
                >
                  {name}
                </button>
              ))
            }
          </div>
          <span class="text-[28px] font-semibold leading-none tracking-[-.02em]"><span data-plan-price>Rp99rb</span><span class="text-[15px] font-normal text-muted-foreground"> /bulan</span></span>
        </div>
      </li>
      <li class="flex flex-col gap-[18px]">
        <span class:list={[circle, 'bg-white text-primary']}>02</span>
        <h3 class={h3}>Isi produk atau impor spreadsheet, lalu pilih logo dan warna.</h3>
        <div class="flex items-center gap-2.5 flex-wrap">
          <span class="inline-flex items-center gap-2 text-[13px] font-medium leading-none bg-white border border-border rounded-[10px] py-[7px] pl-[7px] pr-[11px]"
            ><span class="size-[22px] rounded-md bg-success-icon text-white grid place-items-center text-[10px] font-bold">X</span>produk.xlsx · 312 baris</span
          >
          <span class="flex gap-[5px]">
            <span class="size-5 rounded-full bg-navy shadow-[0_0_0_2px_#fff,0_0_0_3.5px_var(--color-primary)]"></span>
            <span class="size-5 rounded-full bg-[#9DB29A]"></span>
            <span class="size-5 rounded-full bg-[#C8795A]"></span>
          </span>
        </div>
      </li>
      <li class="flex flex-col gap-[18px]">
        <span class:list={[circle, 'bg-primary text-white']}>03</span>
        <h3 class={h3}>Toko langsung tayang di <span class="text-primary-hover">namatokomu.belli.id</span>.</h3>
        <span class="flex items-start gap-2 text-[15px] leading-normal text-foreground group-data-[plan=Mulai]/cara:text-muted-foreground transition-colors duration-300">
          <span class="flex-none mt-0.5 size-[18px] rounded-full bg-success-icon group-data-[plan=Mulai]/cara:bg-border-strong text-white grid place-items-center transition-colors duration-300">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
          </span>
          Paket Katalog dan Jualan bisa pakai domain sendiri.
        </span>
        <div class="flex items-center gap-2 flex-wrap text-[12.5px] leading-none">
          <span class="inline-flex items-center gap-[7px] text-[13px] font-medium bg-white border border-border rounded-full px-3 py-2">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#067647" stroke-width="2.4"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>namatokomu.belli.id
          </span>
          <span class="inline-flex items-center gap-1.5 font-semibold text-success bg-success-bg rounded-full px-2.5 py-[7px]"><span class="size-[7px] rounded-full bg-success-icon"></span>Tayang</span>
          <span class="font-semibold text-primary-hover bg-accent rounded-full px-2.5 py-[7px]">Paket <span data-plan-name>Katalog</span></span>
        </div>
      </li>
    </ol>

    <p class="m-0 bg-white border border-border rounded-[18px] px-6 py-5 text-[15.5px] leading-normal text-body text-pretty">
      <strong class="font-semibold text-foreground">Butuh desain atau fitur khusus?</strong>{' '}
      <a href="https://jadigampang.com" class="text-primary font-semibold underline underline-offset-[3px]">JadiGampang</a> bisa membuatkannya, tetap terhubung ke dashboard Belli.
    </p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-plan]')!;
  const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-plan-set]')];
  for (const b of buttons)
    b.addEventListener('click', () => {
      root.dataset.plan = b.dataset.planSet;
      for (const o of buttons) o.setAttribute('aria-pressed', String(o === b));
      root.querySelector('[data-plan-price]')!.textContent = b.dataset.price!;
      root.querySelector('[data-plan-name]')!.textContent = b.dataset.planSet!;
    });
</script>
