---
import Button from '../components/ui/Button.astro';
import BrowserFrame from '../components/ui/BrowserFrame.astro';
import { config, demoHref } from '../config';

const { autoplay } = config;
const stickers = config.showStickers;

const tabs = [
  { title: 'Ganti harga, langsung tampil', text: 'Tempel dari Excel, isi ke bawah, atau ubah banyak harga sekaligus.' },
  { title: 'Impor ratusan produk sekaligus', text: 'Upload spreadsheet, cek hasilnya, selesai.' },
  { title: 'Tulis artikel, produk ikut tampil', text: 'Jadwalkan terbit. Produk yang kamu sebut muncul di artikel.' },
];

const sizes = ['Single', 'Queen', 'King', 'Super King'];
const colors = [
  { name: 'Putih', swatch: '#FFFFFF', sku: 'PTH' },
  { name: 'Sage', swatch: '#9DB29A', sku: 'SGE' },
  { name: 'Terracotta', swatch: '#C8795A', sku: 'TRC' },
  { name: 'Abu', swatch: '#8A8F98', sku: 'ABU' },
];
const mprices = ['549.000', '689.000', '789.000', '889.000'];
const sizeCodes = ['S', 'Q', 'K', 'SK'];
const importRows = [
  { name: 'Sprei Tencel Set', cat: 'Sprei', vars: '16', price: '549.000', status: 'Siap', ok: true },
  { name: 'Piyama Katun Set', cat: 'Piyama', vars: '12', price: '349.000', status: 'Siap', ok: true },
  { name: 'Handuk Bambu', cat: 'Handuk', vars: '4', price: '189.000', status: 'Siap', ok: true },
  { name: 'Bed Cover Linen', cat: '-', vars: '6', price: '899.000', status: 'Kategori kosong', ok: false },
];
const linen = 'bg-[linear-gradient(160deg,#E8E4DC,#D4CEC2)]';
const slide =
  '[grid-area:1/1] rounded-3xl overflow-hidden flex flex-col gap-1.5 transition-[opacity,translate] duration-500 data-[active=false]:opacity-0 data-[active=false]:translate-y-3 data-[active=false]:pointer-events-none';
const frameShadow = 'shadow-[0_30px_60px_-30px_rgba(10,19,48,.35),0_0_0_1px_#E4E7EC]';
const chip = 'text-[10.5px] font-medium leading-none text-body border border-border rounded-[7px] px-[9px] py-[7px] whitespace-nowrap';
const th = 'px-2.5 py-2 text-[10px] font-semibold leading-none text-muted-foreground';
const line = 'h-[7px] rounded bg-border';
const box = 'border border-border rounded-[10px] p-2.5 flex flex-col gap-1.5';
const boxLabel = 'text-[9.5px] font-semibold leading-none text-muted-foreground uppercase tracking-[.06em]';
---

<section id="demo" class="bg-white px-6 py-24 scroll-mt-3">
  <div data-slider data-autoplay={String(autoplay)} data-interval="6000" class="max-w-[1200px] mx-auto flex flex-col gap-10">
    <div class="flex items-end justify-between gap-6 max-sm:flex-col max-sm:items-start">
      <div class="flex flex-col gap-3">
        <h2 class="h-section">Lihat dashboard-nya</h2>
      </div>
      <div class="flex gap-2.5 flex-none">
        <button data-prev aria-label="Sebelumnya" class="size-12 rounded-full border border-border-strong bg-white text-foreground cursor-pointer grid place-items-center transition-colors duration-200 hover:border-primary hover:text-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
        </button>
        <button data-next aria-label="Berikutnya" class="size-12 rounded-full border-0 bg-navy text-white cursor-pointer grid place-items-center transition-colors duration-200 hover:bg-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>
      </div>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-x-12 gap-y-8 items-center">
    <div class="grid items-start">
      <!-- Slide 1: product editor -->
      <div data-slide="0" data-active="true" aria-hidden="true" class:list={[slide, 'bg-[linear-gradient(135deg,#ECF3FF_0%,#F6F9FF_100%)] pt-5 pl-6']}>
        {
          stickers && (
            <div class="flex items-end gap-1.5 text-navy pr-6">
              <span class="font-hand text-[22px] font-semibold leading-none -rotate-3">ubah 4 harga sekaligus</span>
              <svg width="40" height="30" viewBox="0 0 40 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4c10 2 20 8 28 22" /><path d="M24 20l7 6 3-9" /></svg>
            </div>
          )
        }
        <BrowserFrame url="admin.belli.id/products/sprei-tencel-set" class:list={['rounded-tl-2xl', frameShadow]}>
          <div class="px-4 pt-4 pb-5 flex flex-col gap-3">
            <div class="flex justify-between items-center gap-2.5 flex-wrap">
              <div class="flex flex-col gap-1">
                <span class="text-[10.5px] leading-none text-muted-foreground">Produk / Sprei Tencel Set</span><span class="text-sm font-semibold leading-none">Sprei Tencel Set</span>
              </div>
              <div class="flex gap-1.5 flex-wrap">
                <span class={chip}>Tempel dari Excel</span><span class={chip}>Isi ke bawah</span>
                <span class="text-[10.5px] font-semibold leading-none text-white bg-primary rounded-[7px] px-[9px] py-[7px] whitespace-nowrap">Ubah harga sekaligus</span>
              </div>
            </div>
            <div class="border border-border rounded-[10px] overflow-hidden">
              <div class="grid grid-cols-[1.3fr_repeat(4,1fr)] bg-muted border-b border-border text-[10.5px] font-semibold leading-none">
                <span class="px-2.5 py-2 text-muted-foreground">Warna</span>
                {sizes.map((s, i) => <span class:list={['px-2.5 py-2 text-center', i === 1 ? 'bg-accent text-primary-hover' : 'text-muted-foreground']}>{s}</span>)}
              </div>
              {
                colors.map((c) => (
                  <div class="grid grid-cols-[1.3fr_repeat(4,1fr)] border-b border-border-soft">
                    <span class="px-2.5 py-2 flex items-center gap-1.5 text-[11px] font-medium leading-none">
                      <span class="size-[11px] rounded-full border border-black/[.08]" style={`background:${c.swatch}`} />
                      {c.name}
                    </span>
                    {mprices.map((v, ci) => (
                      <span class:list={['px-2 py-1.5 flex flex-col items-center gap-[3px]', ci === 1 && 'bg-accent']}>
                        <span class:list={['text-[11px] font-medium leading-none', ci === 1 && 'text-primary-hover']}>{v}</span>
                        <span class="text-[8.5px] leading-none text-muted-foreground">TNC-{c.sku}-{sizeCodes[ci]}</span>
                      </span>
                    ))}
                  </div>
                ))
              }
            </div>
            <div class="flex items-center gap-2 text-[11px] font-medium leading-none text-primary-hover bg-accent px-2.5 py-2 rounded-lg">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>Kolom Queen dipilih · 4 varian · harga baru Rp 689.000
            </div>
          </div>
        </BrowserFrame>
      </div>

      <!-- Slide 2: spreadsheet import -->
      <div data-slide="1" data-active="false" aria-hidden="true" class:list={[slide, 'bg-[linear-gradient(225deg,#ECF3FF_0%,#F6F9FF_100%)] pt-5 pr-6']}>
        {
          stickers && (
            <div class="flex items-end justify-end gap-1.5 text-navy pl-6">
              <svg width="40" height="30" viewBox="0 0 40 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M37 4C27 6 17 12 9 26" /><path d="M16 20l-7 6-3-9" /></svg>
              <span class="font-hand text-[22px] font-semibold leading-none rotate-3">312 produk, 1 file</span>
            </div>
          )
        }
        <BrowserFrame url="admin.belli.id/products/import" class:list={['rounded-tr-2xl', frameShadow]}>
          <div class="px-4 pt-4 pb-5 flex flex-col gap-3">
            <div class="flex items-center gap-2 flex-wrap text-[10.5px] font-semibold leading-none">
              <span class="inline-flex items-center gap-1.5 text-muted-foreground"><span class="size-[18px] rounded-full bg-primary text-white grid place-items-center text-[9px]">1</span>Upload</span>
              <span class="w-5 h-px bg-border"></span>
              <span class="inline-flex items-center gap-1.5"><span class="size-[18px] rounded-full bg-primary text-white grid place-items-center text-[9px]">2</span>Cek hasil</span>
              <span class="w-5 h-px bg-border"></span>
              <span class="inline-flex items-center gap-1.5 text-muted-foreground"><span class="size-[18px] rounded-full bg-border-soft grid place-items-center text-[9px]">3</span>Selesai</span>
            </div>
            <div class="flex items-center gap-2.5 border border-border rounded-[10px] px-3 py-2.5">
              <span class="size-8 rounded-lg bg-accent text-primary grid place-items-center flex-none"
                ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18v14H3zM3 10h18M3 15h18M9 5v14M15 5v14"></path></svg></span
              >
              <div class="flex flex-col gap-[3px] flex-1 min-w-0">
                <span class="text-[11.5px] font-semibold leading-none truncate">produk-sleep-project.xlsx</span>
                <span class="text-[10px] leading-none text-muted-foreground">312 baris · 4 kategori · 1.128 varian</span>
              </div>
              <span class="text-[10px] font-medium leading-none text-primary whitespace-nowrap">Ganti file</span>
            </div>
            <div class="border border-border rounded-[10px] overflow-hidden">
              <div class="grid grid-cols-[1.6fr_1fr_.8fr_1fr_.9fr] bg-muted border-b border-border">
                <span class={th}>Nama</span><span class={th}>Kategori</span><span class={th}>Varian</span><span class={th}>Harga</span><span class={th}>Status</span>
              </div>
              {
                importRows.map((r) => (
                  <div class="grid grid-cols-[1.6fr_1fr_.8fr_1fr_.9fr] border-b border-border-soft items-center text-[10.5px] leading-none">
                    <span class="px-2.5 py-2 font-medium truncate">{r.name}</span>
                    <span class="px-2.5 py-2 text-body">{r.cat}</span>
                    <span class="px-2.5 py-2 text-body">{r.vars}</span>
                    <span class="px-2.5 py-2 font-medium">{r.price}</span>
                    <span class="px-2 py-1.5">
                      <span class:list={['text-[8.5px] font-semibold px-[7px] py-1 rounded-full whitespace-nowrap', r.ok ? 'bg-success-bg text-success' : 'bg-warn-bg text-warn']}>{r.status}</span>
                    </span>
                  </div>
                ))
              }
            </div>
            <div class="flex justify-between items-center gap-2.5 flex-wrap">
              <div class="flex gap-1.5 flex-wrap text-[10px] font-semibold leading-none">
                <span class="text-success bg-success-bg px-2 py-[5px] rounded-full">310 siap diimpor</span><span class="text-warn bg-warn-bg px-2 py-[5px] rounded-full">2 perlu dicek</span>
              </div>
              <span class="text-[11px] font-semibold leading-none text-white bg-primary rounded-lg px-3 py-[9px]">Impor 310 produk</span>
            </div>
          </div>
        </BrowserFrame>
      </div>

      <!-- Slide 3: blog editor -->
      <div data-slide="2" data-active="false" aria-hidden="true" class:list={[slide, 'bg-[linear-gradient(135deg,#ECF3FF_0%,#F6F9FF_100%)] pt-5 pl-6']}>
        {
          stickers && (
            <div class="flex items-end gap-1.5 text-navy pr-6">
              <span class="font-hand text-[22px] font-semibold leading-none -rotate-3">terbit otomatis Senin pagi</span>
              <svg width="40" height="30" viewBox="0 0 40 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4c10 2 20 8 28 22" /><path d="M24 20l7 6 3-9" /></svg>
            </div>
          )
        }
        <BrowserFrame url="admin.belli.id/blog/cara-merawat-sprei-tencel" class:list={['rounded-tl-2xl', frameShadow]}>
          <div class="p-4 grid grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-3.5">
            <div class="flex flex-col gap-2.5 min-w-0">
              <span class="text-[15px] font-semibold leading-[1.25] tracking-[-.01em]">Cara merawat sprei tencel supaya awet</span>
              <div class="flex gap-1 flex-wrap text-[10px] font-semibold leading-none">
                {['B', 'I', 'H2', 'Link', 'Gambar'].map((b) => <span class:list={['text-body border border-border rounded-[5px] px-[7px] py-[5px]', b === 'I' && 'italic']}>{b}</span>)}
                <span class="text-primary-hover bg-accent rounded-[5px] px-[7px] py-[5px]">+ Produk</span>
              </div>
              <div class="flex flex-col gap-1.5"><span class:list={[line, 'w-full']}></span><span class:list={[line, 'w-[92%]']}></span><span class:list={[line, 'w-[96%]']}></span><span class:list={[line, 'w-[70%]']}></span></div>
              <div class="flex items-center gap-2 border-[1.5px] border-dashed border-primary bg-accent rounded-[9px] px-2.5 py-2">
                <span class:list={['size-[30px] rounded-md flex-none', linen]}></span>
                <div class="flex flex-col gap-[3px] min-w-0">
                  <span class="text-[10.5px] font-semibold leading-none truncate">Sprei Tencel Set</span>
                  <span class="text-[9.5px] leading-none text-muted-foreground">Mulai Rp 549.000 · tampil di artikel</span>
                </div>
              </div>
              <div class="flex flex-col gap-1.5"><span class:list={[line, 'w-[88%]']}></span><span class:list={[line, 'w-[60%]']}></span></div>
            </div>
            <div class="flex flex-col gap-2.5 min-w-0">
              <div class={box}>
                <span class={boxLabel}>Status</span>
                <span class="self-start text-[10.5px] font-semibold leading-none text-primary-hover bg-accent px-2 py-[5px] rounded-full">Terjadwal</span>
                <span class="text-[10px] leading-[1.4] text-body">Sen, 3 Nov 2026 · 09.00</span>
              </div>
              <div class={box}><span class={boxLabel}>Kategori</span><span class="text-[10.5px] font-medium leading-none">Perawatan</span></div>
              <div class={box}>
                <span class={boxLabel}>Produk terkait</span><span class="text-[10.5px] font-medium leading-none">Sprei Tencel Set</span><span class="text-[10.5px] font-medium leading-none">Pelindung Kasur</span>
              </div>
              <span class="text-[11px] font-semibold leading-none text-white bg-primary rounded-lg px-3 py-[9px] text-center">Jadwalkan</span>
            </div>
          </div>
        </BrowserFrame>
      </div>
    </div>

      <div class="flex flex-col gap-[22px]">
        <span data-counter class="text-[15px] font-medium leading-none tracking-[.06em] text-primary">01 / 03</span>
        <div class="grid">
          {
            tabs.map((t, i) => (
              <div data-slide={i} data-active={String(i === 0)} class="[grid-area:1/1] flex flex-col gap-3.5 transition-[opacity,translate] duration-450 data-[active=false]:opacity-0 data-[active=false]:translate-y-2.5 data-[active=false]:pointer-events-none">
                <h3 class="m-0 text-[clamp(26px,2.6vw,32px)] leading-[1.18] font-semibold tracking-[-.02em] text-pretty">{t.title}</h3>
                <p class="m-0 text-[17px] leading-[1.55] text-body text-pretty">{t.text}</p>
              </div>
            ))
          }
        </div>
        <div class="border-t border-border pt-6 flex flex-col gap-3.5">
          <span class="text-xl font-semibold leading-[1.25]">Lihat sendiri, tanpa daftar.</span>
          <div class="flex items-center gap-x-4 gap-y-3 flex-wrap">
            <Button href={demoHref} target="_blank" rel="noopener" class="shadow-[0_8px_20px_-10px_rgba(47,107,255,.8)] whitespace-nowrap">
              Buka toko demo<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"></path></svg>
            </Button>
            <span class="text-sm leading-[1.4] text-muted-foreground">Langsung masuk. Akun demo hanya bisa melihat, semua datanya fiktif.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/slider';
</script>
