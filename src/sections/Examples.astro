---
// v8: one browser frame crossfading between sites, a side caption, and a tab per site with a 5 s progress bar.
// The eight demo shops, one per website theme: each is {slug}.belli.id, seeded with demo-seed -theme, and its
// screenshot is a 1440x900 WebP in public/contoh/.
import { config } from '../config';

const sites = [
  { cat: 'Busana', title: 'Toko gamis, hijab, dan setelan harian dari Bandung', short: 'Busana muslim', host: 'sahira.belli.id', img: '/contoh/sahira.webp', alt: 'Screenshot website Sahira, tema Busana' },
  { cat: 'Clothing', title: 'Toko kaos, jaket, dan celana untuk sehari-hari', short: 'Pakaian harian', host: 'lantaidua.belli.id', img: '/contoh/lantaidua.webp', alt: 'Screenshot website Lantai Dua, tema Clothing' },
  { cat: 'Woman', title: 'Butik pakaian kerja, rajut, dan hijab wanita', short: 'Fashion wanita', host: 'kirana.belli.id', img: '/contoh/kirana.webp', alt: 'Screenshot website Kirana, tema Woman' },
  { cat: 'Katalog', title: 'Skincare lokal dengan pilihan isi dan warna', short: 'Skincare', host: 'seruni.belli.id', img: '/contoh/seruni.webp', alt: 'Screenshot website Seruni, tema Katalog' },
  { cat: 'Katalog Hangat', title: 'Brand perawatan kulit yang tampil premium', short: 'Kecantikan', host: 'sekarayu.belli.id', img: '/contoh/sekarayu.webp', alt: 'Screenshot website Sekar Ayu, tema Katalog Hangat' },
  { cat: 'Furnitur Klasik', title: 'Mebel jati dan rotan dengan showroom di Jepara', short: 'Mebel jati & rotan', host: 'kayuna.belli.id', img: '/contoh/kayuna.webp', alt: 'Screenshot website Kayuna, tema Furnitur Klasik' },
  { cat: 'Furnitur Earthy', title: 'Kerajinan kayu dan rotan dengan katalog lengkap', short: 'Kerajinan kayu', host: 'wanajati.belli.id', img: '/contoh/wanajati.webp', alt: 'Screenshot website Wanajati, tema Furnitur Earthy' },
  { cat: 'Furnitur Ceria', title: 'Perabot rumah modern yang ringan dan ceria', short: 'Perabot rumah', host: 'ruangrotan.belli.id', img: '/contoh/ruangrotan.webp', alt: 'Screenshot website Ruang Rotan, tema Furnitur Ceria' },
];
const { autoplay } = config;
const fade = 'transition-opacity duration-500 data-[active=false]:opacity-0 data-[active=false]:pointer-events-none';
---

<section id="contoh" class="bg-white px-6 py-24 scroll-mt-3">
  <div data-slider data-autoplay={String(autoplay)} data-interval="5000" class="max-w-[1200px] mx-auto flex flex-col gap-10">
    <div class="flex flex-col gap-3">
      <h2 class="h-section">Contoh website</h2>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] gap-x-11 gap-y-8 items-center">
      <div class="bg-white border border-border rounded-[20px] overflow-hidden shadow-[0_40px_70px_-40px_rgba(10,19,48,.45)]">
        <div class="h-11 bg-canvas border-b border-border flex items-center gap-3.5 px-4">
          <div class="flex gap-1.5 flex-none"><span class="size-2.5 rounded-full bg-border-strong"></span><span class="size-2.5 rounded-full bg-border-strong"></span><span class="size-2.5 rounded-full bg-border-strong"></span></div>
          <div class="flex-1 min-w-0 max-w-[360px] flex items-center gap-[7px] bg-white border border-border rounded-lg px-3 py-1.5 font-mono text-[12.5px] leading-none text-body">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#067647" stroke-width="2.4" class="flex-none"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
            <span class="grid min-w-0">{sites.map((s, i) => <span data-slide={i} data-active={String(i === 0)} class:list={['[grid-area:1/1] truncate', fade]}>{s.host}</span>)}</span>
          </div>
        </div>
        <div class="relative aspect-[16/10] bg-muted">
          {
            sites.map((s, i) => (
              <div data-slide={i} data-active={String(i === 0)} class:list={['absolute inset-0', fade]}>
                <img src={s.img} alt={s.alt} width="1440" height="900" loading="lazy" decoding="async" class="block size-full object-cover object-top" />
              </div>
            ))
          }
        </div>
      </div>

      <div class="grid">
        {
          sites.map((s, i) => (
            <div data-slide={i} data-active={String(i === 0)} class:list={['[grid-area:1/1] flex flex-col gap-[18px] items-start', fade]}>
              <span class="font-mono text-[13.5px] leading-none tracking-[.14em] uppercase text-body">{s.cat}</span>
              <h3 class="m-0 text-[clamp(24px,2.4vw,30px)] leading-[1.2] font-semibold tracking-[-.02em] text-pretty">{s.title}</h3>
              <span class="font-mono text-sm leading-none text-muted-foreground break-all">{s.host}</span>
              <a
                href={'https://' + s.host}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-[9px] bg-primary text-white hover:bg-primary-hover hover:text-white text-base font-semibold leading-none px-[22px] py-[15px] rounded-full no-underline shadow-[0_8px_20px_-10px_rgba(47,107,255,.8)] transition-colors duration-200"
              >
                Buka demo live
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg>
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <div class="grid grid-cols-8 max-lg:grid-cols-4 gap-x-4 gap-y-6">
      {
        sites.map((s, i) => (
          <button data-tab={i} data-active={String(i === 0)} aria-pressed={String(i === 0)} class="group/tab border-0 bg-transparent cursor-pointer text-left p-0 flex flex-col gap-2.5 min-h-11">
            <div data-progress class="h-[3px] rounded-full bg-border overflow-hidden">
              {autoplay && <div class="h-full w-0 bg-primary rounded-full animate-progress [animation-duration:5s] group-data-[active=false]/tab:hidden motion-reduce:hidden" />}
            </div>
            <span class="font-mono text-[11.5px] leading-none tracking-[.12em] uppercase text-muted-foreground group-data-[active=true]/tab:text-primary">{s.cat}</span>
            <span class="text-[14.5px] font-semibold leading-[1.35] text-muted-foreground group-data-[active=true]/tab:text-foreground transition-colors duration-200">{s.short}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/slider';
</script>
