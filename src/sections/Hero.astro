---
import Badge from '../components/ui/Badge.astro';
import BrowserFrame from '../components/ui/BrowserFrame.astro';
import Button from '../components/ui/Button.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { config, slotsText } from '../config';

const products = [
  { name: 'Sprei Tencel Set · Queen', bg: 'bg-[linear-gradient(160deg,#E8E4DC,#D4CEC2)]' },
  { name: 'Piyama Katun Set', price: 'Rp 349.000', bg: 'bg-[linear-gradient(160deg,#D7DFD4,#BFCBBA)]' },
  { name: 'Handuk Bambu', price: 'Rp 189.000', bg: 'bg-[linear-gradient(160deg,#E9D5C9,#D8BBA9)]' },
];
// Initial frame of the price-sync loop: stage 2 (the website already shows the first price).
const HERO_PRICE = '689.000';
---

<div class="relative px-3 pt-3">
  <div class="absolute inset-x-3 top-3 bottom-0 rounded-[28px] bg-hero"></div>
  <div class="relative max-w-[1200px] mx-auto text-white">
    <SiteHeader />

    <div id="konten" tabindex="-1" class="outline-none grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-x-12 gap-y-9 items-center px-6 pt-9 pb-16">
      <div class="flex flex-col gap-[22px] max-w-[600px]">
        <h1 class="m-0 text-[clamp(36px,4.8vw,62px)] leading-[1.06] font-semibold tracking-[-.025em] text-pretty">Website brand sendiri. Ganti harga tanpa developer.</h1>
        <p class="m-0 text-[clamp(16px,1.4vw,19px)] leading-[1.55] text-periwinkle max-w-[540px] text-pretty">
          Pembeli lihat katalog lengkap, lalu pesan lewat WhatsApp. Belli tidak memotong penjualanmu. Mulai Rp49 ribu per bulan.
        </p>
        <div class="flex flex-wrap gap-3">
          <Button href="/kontak?topik=program-perintis" size="xl" lift>
            Coba gratis 3 bulan<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </Button>
          <Button href="#demo" variant="ghost-dark">Lihat demo</Button>
        </div>
        <div class="flex items-center flex-wrap gap-3 text-sm leading-[1.3] text-periwinkle">
          {config.showStickers && <Badge variant="sticker" rotate={-5}>Program Perintis</Badge>}
          <span class="max-w-[460px] text-pretty">Gratis 3 bulan untuk 10 brand pertama. Sisa <span class="font-semibold text-white">{slotsText}</span> slot.</span>
        </div>
      </div>

      <!-- Website ← dashboard, with the price-sync loop (script below sets data-stage) -->
      <div data-hero data-stage="2" aria-hidden="true" class="group/hero relative pb-[78px] max-[560px]:pb-0">
        <div class="relative w-[82%] max-[560px]:w-full">
          <Badge variant="sticker" rotate={-3} class="absolute -top-3.5 left-4 z-[2]">Website brand-mu</Badge>
          <BrowserFrame url="sleepproject.id" maxUrl="max-w-[282px]" class="rounded-2xl text-foreground shadow-[0_50px_90px_-30px_rgba(10,19,48,.65),0_0_0_1px_rgba(255,255,255,.12)]">
            <div class="px-[18px] pt-3.5 pb-[18px] flex flex-col gap-3.5">
              <div class="flex items-center justify-between gap-2.5">
                <span class="text-[13px] font-bold leading-none tracking-[.14em] uppercase">Sleep Project</span>
                <div class="flex gap-3 text-[10.5px] font-medium leading-none text-body"><span>Sprei</span><span>Piyama</span><span>Handuk</span><span>Journal</span></div>
              </div>
              <div class="bg-[#F2EFE9] rounded-[10px] px-4 py-3.5 flex flex-col gap-[5px]">
                <span class="text-[15px] font-semibold leading-[1.2] tracking-[-.01em]">Koleksi Tencel baru</span>
                <span class="text-[10.5px] leading-[1.4] text-body">Sejuk untuk iklim tropis. Tersedia Single sampai Super King.</span>
              </div>
              <div class="grid grid-cols-3 gap-2.5">
                {
                  products.map((p) => (
                    <div class="flex flex-col gap-1.5">
                      <div class:list={['aspect-[4/5] rounded-lg', p.bg]} />
                      <span class="text-[10.5px] font-medium leading-[1.3]">{p.name}</span>
                      {p.price ? (
                        <span class="text-[11.5px] font-semibold leading-none">{p.price}</span>
                      ) : (
                        <span
                          data-h="site"
                          class="self-start px-1.5 py-1 rounded-[5px] text-[11.5px] font-semibold leading-none text-primary-hover transition-[background-color,scale] duration-500 bg-accent group-data-[stage=2]/hero:bg-sun group-data-[stage=2]/hero:scale-[1.08]"
                        >
                          Rp {HERO_PRICE}
                        </span>
                      )}
                    </div>
                  ))
                }
              </div>
              <span class="self-start inline-flex items-center gap-1.5 bg-foreground text-white text-[10.5px] font-semibold leading-none px-[11px] py-2 rounded-[7px]"
                ><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg>Pesan via WhatsApp</span
              >
            </div>
          </BrowserFrame>
        </div>

        <div class="absolute right-0 bottom-0 w-[58%] max-[560px]:static max-[560px]:w-full max-[560px]:mt-[30px]">
          <Badge variant="sticker" color="rose" rotate={3} class="absolute -top-3.5 right-4 z-[2]">Dashboard-mu</Badge>
          <div class="bg-white rounded-[14px] overflow-hidden text-foreground shadow-[0_40px_70px_-24px_rgba(10,19,48,.7),0_0_0_1px_#E4E7EC]">
            <div class="flex items-center gap-2 px-3.5 py-2.5 border-b border-border bg-muted">
              <span class="size-[18px] rounded-[5px] bg-primary text-white grid place-items-center text-[10px] font-bold leading-none">B</span>
              <span class="text-[10.5px] font-medium leading-none text-muted-foreground truncate">Produk / Sprei Tencel Set</span>
            </div>
            <div class="px-3.5 pt-3 pb-3.5 flex flex-col gap-2.5">
              <div class="flex justify-between items-center gap-2">
                <span class="text-[12.5px] font-semibold leading-none">Varian dan harga</span>
                <span class="text-[9.5px] font-medium leading-none text-body border border-border rounded-md px-[7px] py-[5px] whitespace-nowrap">Ubah harga sekaligus</span>
              </div>
              <div class="border border-border rounded-[9px] overflow-hidden text-[10.5px] leading-none">
                <div class="grid grid-cols-3 bg-muted border-b border-border text-[9.5px] font-semibold text-muted-foreground">
                  <span class="px-2.5 py-[7px]">Ukuran</span><span class="px-2.5 py-[7px]">SKU</span><span class="px-2.5 py-[7px]">Harga</span>
                </div>
                <div class="grid grid-cols-3 border-b border-border-soft font-medium">
                  <span class="px-2.5 py-2">Single</span><span class="px-2.5 py-2 text-[10px] font-normal text-muted-foreground">TNC-S</span><span class="px-2.5 py-2">549.000</span>
                </div>
                <div class="grid grid-cols-3 border-b border-border-soft bg-accent font-medium">
                  <span class="px-2.5 py-2">Queen</span><span class="px-2.5 py-2 text-[10px] font-normal text-muted-foreground">TNC-Q</span>
                  <span class="px-2.5 py-1.5 flex items-center">
                    <span
                      data-h="cell"
                      class="inline-flex items-center gap-0.5 px-1.5 py-1 rounded-[5px] bg-white border-[1.5px] font-semibold text-primary-hover transition-[border-color] duration-300 border-periwinkle group-data-[stage=0]/hero:border-primary"
                    >
                      <span data-h="price">{HERO_PRICE}</span><span class="w-[1.5px] h-[11px] bg-primary animate-caret invisible group-data-[stage=0]/hero:visible"></span>
                    </span>
                  </span>
                </div>
                <div class="grid grid-cols-3 font-medium">
                  <span class="px-2.5 py-2">King</span><span class="px-2.5 py-2 text-[10px] font-normal text-muted-foreground">TNC-K</span><span class="px-2.5 py-2">789.000</span>
                </div>
              </div>
              <div class="flex justify-between items-center gap-2 flex-wrap">
                <Badge variant="success" class="text-[9.5px] transition-opacity duration-[400ms] group-data-[stage=0]/hero:opacity-0"
                  ><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>Tersimpan · tampil di website</Badge
                >
                <span data-h="save" class="text-[10px] font-semibold leading-none text-white rounded-md px-2.5 py-[7px] transition-[background-color] duration-300 bg-muted-foreground group-data-[stage=0]/hero:bg-primary">Tersimpan</span>
              </div>
            </div>
          </div>
        </div>

        <div class="absolute left-0 bottom-1.5 w-[40%] flex flex-col items-start gap-1 text-sun max-[560px]:hidden">
          <span class="font-hand text-[clamp(19px,1.9vw,24px)] font-semibold leading-[1.05] -rotate-2 text-pretty">ganti di dashboard, tampil di website</span>
          <svg width="46" height="30" viewBox="0 0 48 30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="flex-none self-end"
            ><path d="M4 24c12 2 26-6 38-18"></path><path d="M30 6h12v12"></path></svg
          >
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Price sync, same timings as the design: type a new price (stage 0), save it (1), the website follows (2).
  // The styles per stage live in the markup as group-data-[stage=N]/hero variants.
  const PRICES = ['689.000', '719.000', '659.000'];
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const el = (k: string) => hero.querySelector<HTMLElement>(`[data-h="${k}"]`)!;
  const [site, price, save] = ['site', 'price', 'save'].map(el);
  let i = 0;
  const render = (stage: number) => {
    const now = PRICES[i];
    hero.dataset.stage = String(stage);
    price.textContent = now;
    save.textContent = stage === 0 ? 'Simpan' : 'Tersimpan';
    site.textContent = 'Rp ' + (stage >= 2 ? now : PRICES[(i + PRICES.length - 1) % PRICES.length]);
  };
  const step = () => {
    i = (i + 1) % PRICES.length;
    render(0);
    setTimeout(() => render(1), 1100);
    setTimeout(() => render(2), 1800);
    setTimeout(step, 4600);
  };
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setTimeout(step, 1800);
</script>
