---
import Badge from '../components/ui/Badge.astro';
import BrowserFrame from '../components/ui/BrowserFrame.astro';
import Button from '../components/ui/Button.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { config, slotsText } from '../config';

const products = [
  { name: 'Sprei Tencel Set · Queen', bg: 'bg-[linear-gradient(160deg,#E8E4DC,#D4CEC2)]' },
  { name: 'Piyama Katun Set', price: 'Rp 349.000', bg: 'bg-[linear-gradient(160deg,#D7DFD4,#BFCBBA)]' },
  { name: 'Handuk Bambu', price: 'Rp 189.000', bg: 'bg-[linear-gradient(160deg,#E9D5C9,#D8BBA9)]' },
];
// Initial frame of the Asisten AI loop (also what reduced motion and no-JS see): stage 2, a price
// request already answered and shown on the website.
const HERO_PRICE = '689.000';
const ASK = 'Harga Sprei Queen jadi 689rb ya';
const REPLY = 'Sprei Tencel Queen: Rp659.000 → Rp689.000. Tersimpan, sudah tampil di website ✓';
const sparkle = 'M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z';
---

<div class="relative px-3 pt-3">
  <div class="absolute inset-x-3 top-3 bottom-0 rounded-[28px] bg-hero"></div>
  <div class="relative max-w-[1200px] mx-auto text-white">
    <SiteHeader />

    <div id="konten" tabindex="-1" class="outline-none grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-x-12 gap-y-9 items-center px-6 pt-9 pb-16">
      <div class="flex flex-col gap-[22px] max-w-[600px]">
        <h1 class="m-0 text-[clamp(36px,4.8vw,62px)] leading-[1.06] font-semibold tracking-[-.025em] text-pretty">Website brand sendiri. Harga dan desain lewat chat.</h1>
        <p class="m-0 text-[clamp(16px,1.4vw,19px)] leading-[1.55] text-periwinkle max-w-[540px] text-pretty">
          Minta Asisten AI ubah harga, produk, tema, atau foto. Website-mu langsung ikut berubah, pembeli pesan lewat WhatsApp, dan Belli tidak memotong penjualanmu.
        </p>
        <div class="flex flex-wrap gap-3">
          <Button href="/kontak?topik=program-perintis" size="xl" lift>
            Coba gratis 3 bulan<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </Button>
          <Button href="#demo" variant="ghost-dark">Lihat demo</Button>
        </div>
        <div class="flex items-center flex-wrap gap-3 text-sm leading-[1.3] text-periwinkle">
          {config.showStickers && <Badge variant="sticker" rotate={-5}>Program Perintis</Badge>}
          <span class="max-w-[460px] text-pretty">Gratis 3 bulan untuk 10 brand pertama. Sisa <span class="font-semibold text-white">{slotsText}</span> slot.</span>
        </div>
      </div>

      <!-- Website ← Asisten AI chat, with the request loop (script below sets data-stage and --brand) -->
      <div data-hero data-stage="2" aria-hidden="true" class="group/hero relative pb-[78px] max-[560px]:pb-0 [--brand:var(--color-foreground)]">
        <div class="relative w-[82%] max-[560px]:w-full">
          <Badge variant="sticker" rotate={-3} class="absolute -top-3.5 left-4 z-[2]">Website brand-mu</Badge>
          <BrowserFrame url="lelap.belli.id" maxUrl="max-w-[282px]" class="rounded-2xl text-foreground shadow-[0_50px_90px_-30px_rgba(10,19,48,.65),0_0_0_1px_rgba(255,255,255,.12)]">
            <div class="px-[18px] pt-3.5 pb-[18px] flex flex-col gap-3.5">
              <div class="flex items-center justify-between gap-2.5">
                <span class="text-[13px] font-bold leading-none tracking-[.14em] uppercase text-(--brand) transition-colors duration-500">Lelap</span>
                <div class="flex gap-3 text-[10.5px] font-medium leading-none text-body"><span>Sprei</span><span>Piyama</span><span>Handuk</span><span>Journal</span></div>
              </div>
              <div class="bg-[color-mix(in_srgb,var(--brand)_9%,#F2EFE9)] transition-colors duration-500 rounded-[10px] px-4 py-3.5 flex flex-col gap-[5px]">
                <span class="text-[15px] font-semibold leading-[1.2] tracking-[-.01em] text-(--brand) transition-colors duration-500">Koleksi Tencel baru</span>
                <span class="text-[10.5px] leading-[1.4] text-body">Sejuk untuk iklim tropis. Tersedia Single sampai Super King.</span>
              </div>
              <div class="grid grid-cols-3 gap-2.5">
                {
                  products.map((p) => (
                    <div class="flex flex-col gap-1.5">
                      <div class:list={['aspect-[4/5] rounded-lg', p.bg]} />
                      <span class="text-[10.5px] font-medium leading-[1.3]">{p.name}</span>
                      {p.price ? (
                        <span class="text-[11.5px] font-semibold leading-none">{p.price}</span>
                      ) : (
                        <span
                          data-h="site"
                          class="self-start px-1.5 py-1 rounded-[5px] text-[11.5px] font-semibold leading-none text-primary-hover transition-[background-color,scale] duration-500 bg-accent group-data-[stage=2]/hero:bg-sun group-data-[stage=2]/hero:scale-[1.08]"
                        >
                          Rp {HERO_PRICE}
                        </span>
                      )}
                    </div>
                  ))
                }
              </div>
              <span class="self-start inline-flex items-center gap-1.5 bg-(--brand) transition-colors duration-500 text-white text-[10.5px] font-semibold leading-none px-[11px] py-2 rounded-[7px]"
                ><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg>Pesan via WhatsApp</span
              >
            </div>
          </BrowserFrame>
        </div>

        <div class="absolute right-0 bottom-0 w-[58%] max-[560px]:relative max-[560px]:w-full max-[560px]:mt-[30px]">
          <Badge variant="sticker" color="rose" rotate={3} class="absolute -top-3.5 right-4 z-[2]">Asisten AI</Badge>
          <div class="bg-white rounded-[14px] overflow-hidden text-foreground shadow-[0_40px_70px_-24px_rgba(10,19,48,.7),0_0_0_1px_#E4E7EC]">
            <div class="flex items-center gap-2 px-3.5 py-2.5 border-b border-border bg-muted">
              <span class="size-[18px] rounded-[5px] bg-primary text-white grid place-items-center"
                ><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={sparkle}></path></svg></span
              >
              <span class="text-[10.5px] font-semibold leading-none">Asisten AI</span>
              <span class="ml-auto inline-flex items-center gap-1 text-[9.5px] font-medium leading-none text-success"><span class="size-1.5 rounded-full bg-success-icon"></span>Aktif</span>
            </div>
            <div class="px-3.5 pt-3 pb-2.5 flex flex-col gap-2 min-h-[124px] text-[11px] leading-[1.4]">
              <span data-h="ask" class="self-end max-w-[85%] bg-primary text-white font-medium rounded-[11px] rounded-br-[3px] px-2.5 py-[7px]">{ASK}</span>
              <span class="self-start max-w-[92%] bg-muted border border-border rounded-[11px] rounded-bl-[3px] px-2.5 py-[7px]">
                <span class="hidden group-data-[stage=0]/hero:inline-flex gap-1 py-1 animate-caret"
                  ><span class="size-1.5 rounded-full bg-muted-foreground"></span><span class="size-1.5 rounded-full bg-muted-foreground"></span><span class="size-1.5 rounded-full bg-muted-foreground"></span></span
                >
                <span data-h="reply" class="group-data-[stage=0]/hero:hidden">{REPLY}</span>
              </span>
            </div>
            <div class="mx-3.5 mb-3.5 flex items-center gap-2 border border-border rounded-lg px-2.5 py-[7px]">
              <span class="flex-1 text-[10.5px] leading-none text-muted-foreground">Ketik permintaan…</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-primary"
                ><path d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18-8.5a.5.5 0 0 0 0-.904z"></path><path d="M6 12h16"></path></svg
              >
            </div>
          </div>
        </div>

        <div class="absolute left-0 bottom-1.5 w-[40%] flex flex-col items-start gap-1 text-sun max-[560px]:hidden">
          <span class="font-hand text-[clamp(19px,1.9vw,24px)] font-semibold leading-[1.05] -rotate-2 text-pretty">cukup chat, website ikut berubah</span>
          <svg width="46" height="30" viewBox="0 0 48 30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="flex-none self-end"
            ><path d="M4 24c12 2 26-6 38-18"></path><path d="M30 6h12v12"></path></svg
          >
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Asisten AI loop: the request (stage 0, the AI is typing), the reply (1), then the website follows with
  // a new price (2) or a new brand colour (3). The colours are the katalog theme's presets (BR-143).
  // The styles per stage live in the markup as group-data-[stage=N]/hero variants.
  const SCRIPTS: ({ price: string } | { color: string; hex: string })[] = [
    { price: '719.000' },
    { color: 'hijau', hex: '#2f5a4c' },
    { price: '659.000' },
    { color: 'terakota', hex: '#9a4e3a' },
    { price: '689.000' },
    { color: 'biru tua', hex: '#2d4a6e' },
  ];
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const el = (k: string) => hero.querySelector<HTMLElement>(`[data-h="${k}"]`)!;
  const [site, ask, reply] = ['site', 'ask', 'reply'].map(el);
  let now = '689.000';
  let i = -1;
  const step = () => {
    i = (i + 1) % SCRIPTS.length;
    const s = SCRIPTS[i];
    if ('price' in s) {
      ask.textContent = `Harga Sprei Queen jadi ${s.price.slice(0, 3)}rb ya`;
      reply.textContent = `Sprei Tencel Queen: Rp${now} → Rp${s.price}. Tersimpan, sudah tampil di website ✓`;
    } else {
      ask.textContent = `Ganti warna website jadi ${s.color}`;
      reply.textContent = `Warna website sekarang ${s.color}. Tersimpan ✓`;
    }
    hero.dataset.stage = '0';
    setTimeout(() => (hero.dataset.stage = '1'), 1200);
    setTimeout(() => {
      if ('price' in s) site.textContent = 'Rp ' + (now = s.price);
      else hero.style.setProperty('--brand', s.hex);
      hero.dataset.stage = 'price' in s ? '2' : '3';
    }, 2000);
    setTimeout(step, 5200);
  };
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setTimeout(step, 2600);
</script>
