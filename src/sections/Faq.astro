---
import Button from '../components/ui/Button.astro';
import { jualanLive, waHref } from '../config';

// Five questions. Gratis 3 bulan, marketplace and own domain are answered by the Perintis box,
// the comparison note and the pricing table, so they're not repeated here.
const FAQS = [
  {
    q: 'Siapa yang membuat websitenya?',
    a: 'Tidak perlu dibuat. Begitu daftar, tokomu tayang di namatokomu.belli.id. Kalau bayar Katalog atau Jualan tahunan, kami isikan produk dan atur tokonya. Butuh desain atau fitur khusus? JadiGampang bisa membuatkannya.',
  },
  { q: 'Siapa yang input produk?', a: 'Kamu, lewat dashboard atau impor spreadsheet. Kalau bayar Katalog atau Jualan tahunan, kami isikan 50 produk pertama.' },
  { q: 'Pembeli bisa bayar online?', a: jualanLive ? 'Bisa, di paket Jualan.' : 'Segera, lewat paket Jualan.' },
  {
    q: 'Kalau berhenti langganan?',
    a: 'Toko tetap tayang sampai masa bayar habis. Data pesanan bisa kamu unduh kapan saja, data produk kami kirim sebagai spreadsheet kalau diminta, dan domain tetap atas namamu. Kembali dalam 30 hari, toko tayang lagi seperti semula. Setelah itu data dihapus permanen.',
  },
  { q: 'Data saya aman?', a: 'Data tiap toko disimpan terpisah dan hanya bisa dilihat timmu. Kamu atur siapa boleh apa.' },
];
---

<section id="faq" class="max-w-[1248px] mx-auto px-6 pt-24 pb-14 scroll-mt-3 grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-12 items-start">
  <div class="md:sticky md:top-7 flex flex-col items-start gap-4 max-w-[460px]">
    <h2 class="h-section">Tanya jawab</h2>
    <p class="m-0 text-[17px] leading-[1.55] text-body text-pretty">Belum terjawab? Tanya langsung lewat WhatsApp.</p>
    <Button href={waHref} variant="secondary" size="md">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg>Chat WhatsApp
    </Button>
  </div>
  <div class="flex flex-col gap-2.5">
    {
      FAQS.map((f, i) => (
        <details name="faq" open={i === 0} class="faq group bg-white border border-border rounded-2xl overflow-hidden transition-colors duration-250 open:border-primary">
          <summary class="list-none [&::-webkit-details-marker]:hidden flex items-center justify-between gap-4 cursor-pointer px-[22px] py-5 text-[17px] font-semibold leading-[1.35]">
            <span>{f.q}</span>
            <span class="flex-none size-7 rounded-full bg-accent text-primary grid place-items-center transition-transform duration-250 group-open:rotate-45">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="m-0 px-[22px] pb-[22px] text-base leading-[1.6] text-body text-pretty">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
