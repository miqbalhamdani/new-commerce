---
const items = ['Fashion', 'Bedding', 'Sleepwear', 'Kosmetik', 'Skincare', 'Makanan kemasan', 'Maklon & pabrik', 'Handuk', 'Aksesori'];
---

<div class="max-w-[1248px] mx-auto px-6 py-8 flex items-center gap-6">
  <span class="flex-none flex items-center gap-6 text-[13px] font-semibold leading-[1.3] tracking-[.08em] uppercase text-body-strong whitespace-nowrap max-[560px]:whitespace-normal max-[560px]:max-w-[130px]"
    >Untuk brand dengan produk sendiri<span class="w-px h-6 bg-border-strong flex-none"></span></span
  >
  <div class="flex-1 min-w-0 overflow-hidden relative mask-fade-x">
    <div class="flex w-max animate-marquee motion-reduce:animate-none">
      {
        items.concat(items).map((t) => (
          <span class="inline-flex items-center gap-[18px] px-[18px] text-[15px] font-medium leading-none text-body whitespace-nowrap">
            {t}
            <span class="size-1.5 rounded-full bg-primary inline-block" />
          </span>
        ))
      }
    </div>
  </div>
</div>
