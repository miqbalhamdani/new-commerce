---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { config } from '../config';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean; // 404
  image?: { src: string; alt: string }; // share image, defaults to /og.jpg (1200×630)
  published?: Date; // marks the page as an article
  schema?: object[]; // JSON-LD
};

const {
  title = 'Belli: website brand sendiri, harga kamu ganti sendiri',
  description = 'Website katalog untuk brand-mu. Pembeli lihat katalog lengkap, lalu pesan lewat WhatsApp. Tanpa potongan penjualan. Mulai Rp49 ribu/bulan.',
  noindex,
  image,
  published,
  schema = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image?.src ?? '/og.jpg', Astro.site);
const ogAlt = image?.alt ?? 'Belli: website brand sendiri, ganti harga tanpa developer. Mulai Rp49 ribu per bulan.';
const { gaId } = config;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Belli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-outfit" preload />
    <Font cssVariable="--font-caveat" />
    <Font cssVariable="--font-dm-mono" />
    {schema.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : schema)} />}
    {
      gaId && (
        <Fragment>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', gaId);
            // gtag.js is 180 KB; fetch it after the page has loaded so it doesn't compete with fonts and CSS. Calls made before then wait in dataLayer.
            addEventListener('load', () => {
              const s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
              document.head.append(s);
            });
          </script>
        </Fragment>
      )
    }
  </head>
  <body>
    <a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-xl focus:bg-white focus:px-4 focus:py-3 focus:text-[15px] focus:font-semibold focus:text-foreground focus:shadow-lg">Langsung ke konten</a>
    <slot />
  </body>
</html>
