---
// Header and footer for the subpages (Kontak, Kebijakan Privasi), from their design files in design/.
import Base from './Base.astro';
import Button from '../components/ui/Button.astro';
import { config, waDisplay, waHref } from '../config';

type Props = { title: string; description: string };

const { title, description } = Astro.props;
const cols = [
  { label: 'Belli', links: [['/', 'Beranda'], ['/#harga', 'Harga'], ['/#faq', 'Tanya jawab'], ['/blog', 'Blog'], ['/kontak', 'Kontak']] },
  { label: 'Kontak', links: [[waHref, `WhatsApp ${waDisplay}`], [`mailto:${config.email}`, `Email ${config.email || '[ISI]'}`]] },
  { label: 'Legal', links: [['/kebijakan-privasi', 'Kebijakan Privasi'], ['/syarat-ketentuan', 'Syarat dan Ketentuan']] },
];
const logo = 'flex items-center gap-2.5 no-underline text-foreground';
const navLink = 'text-[15px] font-medium leading-none text-body no-underline px-3.5 py-[14px] rounded-[10px] hover:bg-canvas hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:font-semibold';
const here = (href: string) => (Astro.url.pathname.replace(/\/$/, '') === href ? 'page' : undefined);
---

<Base title={title} description={description}>
  <div id="top" class="min-h-dvh flex flex-col bg-white">
    <header>
      <div class="max-w-[1248px] mx-auto px-6 py-[18px] flex items-center justify-between gap-4">
        <a href="/" class={logo}>
          <span class="size-[34px] rounded-[10px] bg-primary grid place-items-center text-lg font-bold leading-none text-white">B</span>
          <span class="text-xl font-semibold leading-none tracking-[-.01em]">Belli</span>
        </a>
        <div class="flex items-center gap-2">
          <a href="/" class:list={[navLink, 'max-sm:hidden']}>Beranda</a>
          <a href="/kontak" aria-current={here('/kontak')} class={navLink}>Kontak</a>
          <Button href="/kontak?topik=program-perintis" size="sm">Coba gratis</Button>
        </div>
      </div>
    </header>

    <main class="flex-1 w-full max-w-[1200px] mx-auto px-6 pt-[72px] pb-24 max-sm:pt-12">
      <slot />
    </main>

    <footer class="bg-band [--band-to:var(--color-muted)]">
      <div class="max-w-[1248px] mx-auto px-6 pt-12 pb-7 flex flex-col gap-9">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-8">
          <div>
            <a href="/" class={logo}>
              <span class="size-[34px] rounded-[10px] bg-primary grid place-items-center text-lg font-bold leading-none text-white">B</span>
              <span class="text-xl font-semibold leading-none tracking-[-.01em]">Belli</span>
            </a>
          </div>
          {
            cols.map((c) => (
              <div class="flex flex-col gap-3">
                <span class="text-sm font-semibold leading-none">{c.label}</span>
                {c.links.map(([href, text]) => (
                  <a href={href} class="text-[15px] leading-[1.4] text-body no-underline hover:text-primary">{text}</a>
                ))}
              </div>
            ))
          }
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5">
          <span class="text-[13.5px] leading-[1.4] text-muted-foreground">© 2026 Belli. Hak cipta dilindungi.</span>
          <a href="#top" class="inline-flex items-center gap-1.5 text-sm font-medium leading-none text-body no-underline hover:text-primary py-2">
            Kembali ke atas<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
          </a>
        </div>
      </div>
    </footer>
  </div>
</Base>
