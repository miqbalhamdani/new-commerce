---
// Blog pages (design/Belli Blog.dc.html, Belli Blog Detail.dc.html): light site header, content,
// then the landing page's closing CTA and footer.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FinalCta from '../sections/FinalCta.astro';
import Footer from '../sections/Footer.astro';

type Props = { title: string; description: string; image?: { src: string; alt: string }; published?: Date; schema?: object[] };

const { title, description, image, published, schema } = Astro.props;
---

<Base title={title} description={description} image={image} published={published} schema={schema}>
  <div class="bg-white overflow-x-clip">
    <div class="max-w-[1200px] mx-auto">
      <SiteHeader tone="light" current="/blog" />
    </div>
    <main id="konten" tabindex="-1" class="outline-none">
      <slot />
      <FinalCta />
    </main>
    <Footer />
  </div>
</Base>
